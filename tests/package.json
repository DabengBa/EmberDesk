{
    "name": "emberdesk-tests",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.0.0-rc.5",
    "license": "AGPL-3.0",
    "scripts": {
        "test": "pnpm run test:all",
        "test:unit": "node run-test-lane.mjs unit",
        "test:component": "node run-test-lane.mjs component",
        "test:integration": "node run-test-lane.mjs integration",
        "test:all": "node run-test-lane.mjs all && node run-playwright-lane.mjs",
        "test:e2e": "node run-playwright-lane.mjs",
        "test:inventory": "node ../scripts/run-test-inventory.mjs",
        "lint": "eslint \"**/*.js\" ./*.js",
        "lint:fix": "eslint \"**/*.js\" ./*.js --fix"
    },
    "dependencies": {
        "@playwright/test": "^1.56.1",
        "@types/jest": "^29.5.12",
        "eslint": "10.4.0",
        "jest": "^29.7.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint-plugin-jest": "29.15.2",
        "eslint-plugin-playwright": "2.10.4",
        "globals": "17.6.0"
    }
}
