    "name": "emberdesk",
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "license": "AGPL-3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/DabengBa/EmberDesk.git"
    },
    "version": "1.18.0",
    "scripts": {
        "init": "node src/server-init.ts",
        "test": "pnpm --dir tests run test:unit",
        "test:unit": "pnpm --dir tests run test:unit",
        "test:component": "pnpm --dir tests run test:component",
        "test:integration": "pnpm --dir tests run test:integration",
        "test:all": "pnpm --dir tests run test:all",
        "test:compat": "pnpm --dir tests run test:unit -- script-js-composition-root.test.js react-runtime-boundary.test.js react-runtime-port.test.js main-chat-store.test.js main-chat-store-projection.test.js react-workspace-panels-helpers.test.js chat-workspace-structure.test.js --runInBand",
        "test:e2e": "pnpm --dir tests run test:e2e",
        "test:inventory": "pnpm --dir tests run test:inventory",
        "start": "node server.js",
        "debug": "node --inspect server.js",
        "dev": "vite",
        "dev:express": "node server.js",
        "dev:all": "concurrently \"pnpm run dev:express\" \"pnpm run dev\"",
        "build:lib": "vite build --mode lib",
        "build:react": "vite build --mode login",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
        "docs:check": "node .docs/db/scripts/doc-compiler.js check && node scripts/docs-integrity.mjs",
        "docs:build": "node .docs/db/scripts/doc-compiler.js build",
        "docs:tree": "node scripts/docs-runtime.mjs tree",
        "docs:index": "node scripts/docs-runtime.mjs index",
        "docs:search": "node scripts/docs-runtime.mjs search",
        "docs:show": "node scripts/docs-runtime.mjs show",
        "perf:startup": "node scripts/startup-performance-runner.mjs",
        "perf:interaction": "node scripts/interaction-performance-runner.mjs",
        "start:global": "node server.js --global",
        "start:no-csrf": "node server.js --disableCsrf",
        "lint": "eslint \"public/**/*.js\" \"./*.js\" && oxlint src --ignore-pattern \"**/*.js\" --tsconfig tsconfig.server.json --deny-warnings && pnpm run typecheck",
        "lint:fast": "oxlint src public app *.js *.ts",
        "lint:fix": "eslint \"public/**/*.js\" \"./*.js\" --fix",
        "plugins:update": "node plugins update",
        "plugins:install": "node plugins install"
    },
    "bin": {
        "sillytavern": "./src/server-global.ts"
    },
    "rules": {
        "no-path-concat": "off",
        "no-var": "off"
    },
    "main": "server.js",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylexjs/stylex": "0.19.2",
        "@stylexjs/unplugin": "0.19.2",
        "@tanstack/router-vite-plugin": "^1.167.49",
        "@types/archiver": "^8.0.0",
        "@types/bytes": "^3.1.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-session": "^2.0.49",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/lodash": "^4.17.27",
        "@types/mime-types": "^3.0.1",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/node-persist": "^3.1.8",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/response-time": "^2.3.9",
        "@types/write-file-atomic": "^4.0.3",
        "@types/yargs": "^17.0.35",
        "@types/yauzl": "^3.4.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "eslint": "10.15.0",
        "eslint-plugin-jsdoc": "65.5.0",
        "globals": "17.14.0",
        "oxlint": "1.94.0",
        "typescript": "7.0.2",
        "vite": "8.3.8"
    }
}
